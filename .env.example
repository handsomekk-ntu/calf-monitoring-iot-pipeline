# Copy to .env and change every value. Never commit the real .env.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-please
INFLUX_ORG=my_farm
INFLUX_BUCKET=calf_data
# Any long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
INFLUX_TOKEN=change-me
INFLUX_URL=http://localhost:8086

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/calf/status
